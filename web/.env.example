WEB_HOST=0.0.0.0
WEB_PORT=8080
DASHBOARD_TOKEN=

ROS_SETUP=/opt/ros/jazzy/setup.bash
WORKSPACE_SETUP=/home/teto/ros2_ws/install/setup.bash

AUTO_CMD=ros2 run ugv01_room_explore auto_explore --ros-args -p cmd_topic:=/cmd_vel_auto -p scan_angle_offset_deg:=0.0 -p forward_wall:=0.045 -p forward_explore:=0.065 -p turn_speed:=0.28 -p corner_turn_speed:=0.18 -p back_speed:=0.045 -p front_emergency:=0.30 -p front_block:=0.55 -p front_clear:=0.75

# Optional. Defaults are ~/.ros/ugv01/maps and ~/.ros/ugv01/logs.
# UGV_MAPS_DIR=/home/teto/.ros/ugv01/maps
# UGV_LOGS_DIR=/home/teto/.ros/ugv01/logs
# web_navigation.launch.py enables managed mode automatically.
# UGV_MANAGED_STACK=1
